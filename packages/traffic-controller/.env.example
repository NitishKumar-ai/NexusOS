# NexusOS Traffic Controller — Environment Variables

# Port the Rust gateway listens on
PORT=3000

# SQLite database path (persists missions + pipeline state)
DATABASE_URL=sqlite://nexusos.db

# ── OpenClaw Gateway ─────────────────────────────────────────────
# URL where your OpenClaw instance is running (default: port 18789)
OPENCLAW_GATEWAY_URL=http://localhost:18789

# Bearer token for authenticating to the OpenClaw gateway
OPENCLAW_TOKEN=your-openclaw-token-here

# HITL timeout settings
HITL_P2_TIMEOUT_MINUTES=30
HITL_P8_TIMEOUT_MINUTES=60
