# NexusOS Traffic Controller — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── NexusOS Traffic Controller ─────────────────────────────────────────────────

# Port the Rust gateway listens on
PORT=3000

# SQLite database path (persists missions + pipeline state)
DATABASE_URL=sqlite://nexusos.db

# ── OpenClaw Gateway ───────────────────────────────────────────────────────────

# URL where your OpenClaw instance is running (default: port 18789)
OPENCLAW_GATEWAY_URL=http://localhost:18789

# Bearer token for authenticating to the OpenClaw gateway
# Generate with: openclaw token create
OPENCLAW_TOKEN=your-openclaw-token-here

# Agent ID registered in OpenClaw for NexusOS
NEXUSOS_AGENT_ID=nexusos-coder

# Path to NexusOS SOUL.md (relative to OpenClaw workspace root)
NEXUSOS_SOUL_PATH=./packages/agent-harness/soul/SOUL.md

# ── Channel Configuration ──────────────────────────────────────────────────────
# NOTE: NexusOS does NOT run its own channel bots.
# All channels are managed by OpenClaw. Configure them in openclaw.json.
# These vars are only used if you connect to OpenClaw's gateway programmatically.

# Dashboard gateway URL (used by Next.js dashboard)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000

# ── MCP Connectors ─────────────────────────────────────────────────────────────

# Linear (for creating tickets from mission results)
LINEAR_API_KEY=lin_api_...

# Firebase (for state persistence)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-service-account.json

# Figma (for reading design files)
FIGMA_API_KEY=figd_...

# GitHub (for creating PRs from missions)
GITHUB_TOKEN=ghp_...

# ── AgentShield ────────────────────────────────────────────────────────────────

# AgentShield scan level (used at P6)
# Options: standard | deep | opus
AGENTSHIELD_SCAN_LEVEL=standard
